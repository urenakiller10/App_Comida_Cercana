<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenido principal de la pantalla -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra de herramientas o ActionBar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/light_gray"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            android:elevation="4dp"
            android:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        <!-- Contenido de la pantalla principal -->
        <FrameLayout
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/white">

            <!-- Aquí agregamos la tabla con scroll -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1"
                    android:padding="16dp"
                    android:background="@android:color/white"
                    android:showDividers="middle"
                    android:divider="@android:color/darker_gray">

                    <!-- Primera fila de la tabla (encabezado) -->
                    <TableRow>
                        <TextView
                            android:text="Creador"
                            android:padding="8dp"
                            android:textStyle="bold" />
                        <TextView
                            android:text="Fecha Creación"
                            android:padding="8dp"
                            android:textStyle="bold" />
                        <TextView
                            android:text="Fecha Límite"
                            android:padding="8dp"
                            android:textStyle="bold" />
                        <TextView
                            android:text="Nombre"
                            android:padding="8dp"
                            android:textStyle="bold" />
                        <TextView
                            android:text="Objetivo de Recaudación"
                            android:padding="8dp"
                            android:textStyle="bold" />
                    </TableRow>

                    <!-- Fila de datos (ejemplo) -->
                    <TableRow>
                        <TextView
                            android:text="Juan Perez"
                            android:padding="8dp" />
                        <TextView
                            android:text="01/01/2024"
                            android:padding="8dp" />
                        <TextView
                            android:text="31/12/2024"
                            android:padding="8dp" />
                        <TextView
                            android:text="Recaudación A"
                            android:padding="8dp" />
                        <TextView
                            android:text="10000"
                            android:padding="8dp" />
                    </TableRow>

                    <!-- Otra fila de datos (ejemplo) -->
                    <TableRow>
                        <TextView
                            android:text="Maria Lopez"
                            android:padding="8dp" />
                        <TextView
                            android:text="15/02/2024"
                            android:padding="8dp" />
                        <TextView
                            android:text="15/08/2024"
                            android:padding="8dp" />
                        <TextView
                            android:text="Recaudación B"
                            android:padding="8dp" />
                        <TextView
                            android:text="15000"
                            android:padding="8dp" />
                    </TableRow>

                </TableLayout>

            </ScrollView>

        </FrameLayout>

        <!-- Botón Crear Proyecto -->
        <Button
            android:id="@+id/create_project_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear Proyecto"
            android:textColor="@android:color/black"
            android:background="@color/colorAccent"
            android:layout_margin="16dp"
            android:padding="16dp"
            android:layout_gravity="center" />

    </LinearLayout>

    <!-- Menu lateral (Navigation Drawer) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:menu="@menu/drawer_menu"
        app:headerLayout="@layout/nav_header" />

</androidx.drawerlayout.widget.DrawerLayout>
