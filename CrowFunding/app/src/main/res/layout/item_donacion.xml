<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_marginBottom="8dp">

    <!-- Nombre del usuario que realizó la donación -->
    <TextView
        android:id="@+id/tvNombreUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NombreUsuario: John Doe"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <!-- Nombre del proyecto al que se realizó la donación -->
    <TextView
        android:id="@+id/tvNombreProyecto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proyecto: Proyecto A"
        android:textSize="16sp"
        android:textColor="@android:color/black" />

    <!-- Monto de la donación -->
    <TextView
        android:id="@+id/tvMontoDonacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Monto: $1000"
        android:textSize="16sp"
        android:textColor="@android:color/black" />

    <!-- Fecha de la donación -->
    <TextView
        android:id="@+id/tvFechaDonacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fecha: 20/08/2024"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray" />

</LinearLayout>
