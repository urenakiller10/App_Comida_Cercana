<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <!-- Título -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mi Cartera"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:gravity="center" />

    <!-- Saldo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saldo Actual:"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/saldo_editText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Campo para agregar dinero y botón "Traer dinero" -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cantidad a traer"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/traer_dinero_editText"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:hint="Ingrese la cantidad"
        android:inputType="numberDecimal" />

    <Button
        android:id="@+id/traer_dinero_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Traer dinero"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <!-- Botón de Historial de Donaciones -->
    <Button
        android:id="@+id/historial_donaciones_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Historial de Donaciones"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF" />

</LinearLayout>