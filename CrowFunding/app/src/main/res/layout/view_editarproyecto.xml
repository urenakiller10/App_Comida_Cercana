<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <!-- Título -->
    <TextView
        android:id="@+id/tvTituloEditarProyecto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editar Proyecto"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:gravity="center" />

    <!-- Contenedor del formulario -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_border"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nombre del Proyecto -->
        <TextView
            android:id="@+id/tvNombreProyecto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Proyecto" />

        <EditText
            android:id="@+id/etNombreProyecto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:hint="Nombre del Proyecto"
            android:inputType="text" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="16dp"
            android:hint="Descripción"
            android:inputType="textMultiLine" />

        <!-- Mensaje para el donador -->
        <TextView
            android:id="@+id/tvMensajeDonador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensaje para el donador" />

        <EditText
            android:id="@+id/etMensajeDonador"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="16dp"
            android:hint="Mensaje para el donador"
            android:inputType="textMultiLine" />

        <!-- Objetivo de Financiación -->
        <TextView
            android:id="@+id/tvObjetivoFinanciacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Objetivo de Financiación" />

        <EditText
            android:id="@+id/etObjetivoFinanciacion"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_marginBottom="16dp"
            android:hint="Objetivo de Financiación"
            android:inputType="numberDecimal" />

        <!-- Tipo de proyecto -->
        <TextView
            android:id="@+id/tvTipoProyecto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de proyecto" />

        <EditText
            android:id="@+id/etTipoProyecto"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_marginBottom="16dp"
            android:hint="Tipo de proyecto"
            android:inputType="text" />
    </LinearLayout>

    <!-- Botones de acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnVolverInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volver al inicio"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>