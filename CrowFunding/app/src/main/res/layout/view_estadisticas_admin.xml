<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeAdmin">

    <!-- Título o encabezado -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estadísticas del Sistema"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- CardView para Usuarios Activos -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardUsuariosActivos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/txtUsuariosActivos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuarios Activos: 0"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:padding="16dp"/>
    </androidx.cardview.widget.CardView>

    <!-- CardView para Cantidad de Proyectos -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCantidadProyectos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/cardUsuariosActivos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/txtCantidadProyectos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cantidad de Proyectos: 0"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:padding="16dp"/>
    </androidx.cardview.widget.CardView>

    <!-- CardView para Cantidad de Donaciones -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCantidadDonaciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/cardCantidadProyectos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/txtCantidadDonaciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cantidad de Donaciones: 0"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:padding="16dp"/>
    </androidx.cardview.widget.CardView>

    <!-- CardView para Total de Usuarios -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTotalUsuarios"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/cardCantidadDonaciones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/txtTotalUsuarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Usuarios: 0"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:padding="16dp"/>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
