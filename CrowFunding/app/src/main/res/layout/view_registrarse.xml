<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <!-- Título -->
    <TextView
        android:id="@+id/tvTituloRegistro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrarse"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:gravity="center" />

    <!-- Contenedor del formulario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/rounded_border">

        <!-- Correo -->
        <TextView
            android:id="@+id/tvCorreo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correo" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="16dp"
            android:hint="Correo"
            android:inputType="textEmailAddress" />

        <!-- Cédula -->
        <TextView
            android:id="@+id/tvCedula"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cédula" />

        <EditText
            android:id="@+id/etCedula"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:hint="Cédula"
            android:inputType="number" />

        <!-- Contraseña -->
        <TextView
            android:id="@+id/tvContrasena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contraseña" />

        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:hint="Contraseña"
            android:inputType="textPassword" />

        <!-- Área de trabajo -->
        <TextView
            android:id="@+id/tvAreaTrabajo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Área de trabajo" />

        <EditText
            android:id="@+id/etAreaTrabajo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:hint="Área de trabajo"
            android:inputType="text" />

        <!-- Cantidad de dinero inicial -->
        <TextView
            android:id="@+id/tvDineroInicial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cantidad de dinero inicial" />

        <EditText
            android:id="@+id/etDineroInicial"
            android:layout_width="match_parent"
            android:layout_height="59dp"
            android:layout_marginBottom="16dp"
            android:hint="Cantidad de dinero"
            android:inputType="numberDecimal" />
    </LinearLayout>

    <!-- Botón de Registrarse -->
    <Button
        android:id="@+id/btnRegistrarse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrarse"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_marginTop="24dp" />

</LinearLayout>